# Copy to .env (gitignored) and fill in. SST and Next.js load it automatically.

# GitHub "owner/repo" used for source, issue and "edit this page" links.
NEXT_PUBLIC_GITHUB_REPO=ljappsolutions/capto

# --- Deployment only (yarn deploy) ---
# AWS CLI profile to deploy with. Leave unset to use the default credential chain.
AWS_PROFILE=
# Custom domain. Leave unset to deploy to the CloudFront URL only.
CAPTO_SITE_DOMAIN=
# ACM certificate ARN in us-east-1 covering CAPTO_SITE_DOMAIN.
CAPTO_SITE_CERT_ARN=
